</dialect>
</step>
<step action='assertExists' value='' type='web' desc='Validate that last page arrow is visible.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='span(&quot;Go to last page&quot;)' fallback='true' selected='true'/>
   <accessor type='unknown' value='svg(&quot;class==lucide lucide-arrow-right-to-line size-4&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='clickIfFound' value='' type='web' desc='Click on go to last page arrow.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
