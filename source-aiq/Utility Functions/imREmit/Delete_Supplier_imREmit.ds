<testcase   name= 'Delete_Supplier_imREmit.ds' description= '' author= 'null' version= ''>
<dpl filename='REPOSITORY/IM_Repo/Resources/IM_DPL1.csv' exectype='runstepbystep' errorhandling='' type='HashDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='store' value='$SupplierName' type='web' desc='Store customer name' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
