   <accessor type='Parent' value='link(0, _in(nav({&apos;aria-label&apos;:&apos;imREmit Subroute Navigation&apos;})))' fallback='true' selected='false'/>
   <accessor type='Text' value='link(&quot;imREmit Dashboard&quot;)' fallback='true' selected='false'/>
</dialect>
