   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;:r2fs:&apos;]&quot;).xy(0.17, 0.30 )' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;relative flex cursor-pointer select-none items-center rounded-sm px-2 py-1.5 text-sm outline-none aria-selected:bg-accent aria-selected:text-accent-foreground data-[disabled]:pointer-events-none data-[disabled]:opacity-50&quot;]&apos;).xy(0.17, 0.30 )' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Pay By Email&quot;]&apos;).xy(0.17, 0.30 )' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/article/main/article/div[2]/div/form/div/div/div[6]/div/div/div/div/div/div/div&apos;).xy(0.17, 0.30 )' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;:r2fs:&apos;)&quot;).xy(0.17, 0.30 )' fallback='true' selected='false'/>
   <accessor type='Attribute' value='div({&apos;role&apos;:&apos;option&apos;}).xy(0.17, 0.30 )' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;relative flex cursor-pointer select-none items-center rounded-sm px-2 py-1.5 text-sm outline-none aria-selected:bg-accent aria-selected:text-accent-foreground data-[disabled]:pointer-events-none data-[disabled]:opacity-50&quot;]&apos;).xy(0.17, 0.30 )' fallback='true' selected='false'/>
   <accessor type='Parent' value='div(35, _in(div(&quot;root&quot;))).xy(0.17, 0.30 )' fallback='true' selected='false'/>
   <accessor type='Text' value='div(&quot;Pay By Email&quot;).xy(0.17, 0.30 )' fallback='true' selected='false'/>
</dialect>
</step>
