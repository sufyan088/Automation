   <accessor type='JQuery' value='byJQuery(&apos;input[value=&quot;LA&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathId' value='byXPath(&apos;//*[@id=&quot;:r1au:&quot;]&apos;)' fallback='true' selected='false'/>
