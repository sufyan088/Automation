<step action='assertExists' value='""' type='web' desc='Validate that dashbaord button is visible' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='link(&quot;Dashboard&quot;)' fallback='true' selected='true'/>
   <accessor type='AttrHref' value='link(&quot;/app/duplicate-payments/dashboard[1]&quot;)' fallback='true' selected='false'/>
