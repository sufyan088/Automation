</dialect>
</step>
<step action='click' value='' type='web' desc='Click on status button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='button(&quot;Status&quot;)' fallback='true' selected='true'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Validate that Invoice Number Mismatch status is visible in dropdown' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='span(&quot;Invoice Number Mismatch&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='span(12, _in(div({&apos;id&apos;:&apos;root&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='span(&quot;font-bold&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;root&apos;]/article/main/article/section[2]/div/div[1]/div/div/p[2]/span&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;font-bold&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Invoice Number Mismatch&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/article/main/article/section[2]/div/div/div/div/p[2]/span&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;root&apos;)/article[@class=&apos;flex min-h-screen flex-col&apos;]/main[@class=&apos;break-word flex-1 overflow-auto bg-background px-6 py-4 md:ml-16&apos;]/article[@class=&apos;w-full flex-1 bg-background&apos;]/section[2]/div[@class=&apos;rounded-lg border border-foreground bg-root text-card-foreground shadow-sm&apos;]/div[@class=&apos;flex-col space-y-1.5 p-6 flex gap-2&apos;]/div[@class=&apos;grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-2&apos;]/div[@class=&apos;grid grid-cols-3 text-lg&apos;]/p[@class=&apos;flex flex-col text-lg&apos;]/span[@class=&apos;font-bold&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;flex-col space-y-1.5 p-6 flex gap-2&quot;] &gt; div[class=&quot;grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-2&quot;] &gt; div[class=&quot;grid grid-cols-3 text-lg&quot;] &gt; p[class=&quot;flex flex-col text-lg&quot;] &gt; span[class=&quot;font-bold&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='span(12, _in(div(&quot;root&quot;)))' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='Select Invoice Number Mismatch from dropdown' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='span([&quot;Invoice Number Mismatch&quot;])' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;:rqk:&apos;]/span&quot;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/article/main/article/section[2]/div[2]/form/div/div[2]/div/div/div/div/div[2]/div/div/div/div/div/div/div[8]/span&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;:rqk:&apos;)/span[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='span(7, _in(div({&apos;aria-label&apos;:&apos;Suggestions&apos;})))' fallback='true' selected='false'/>
   <accessor type='Text' value='span(&quot;Invoice Number Mismatch[1]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../Utility Functions/Logout_Function.ds"' fallback='true' selected='true'/>
</dialect>
</step>
</testcase>