   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[1]//td[3]//a//p[@class=&quot;leading-6 cursor-pointer font-semibold underline hover:text-theme&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[1]//td[3]//a//p[text()=&quot;Supplier/[Sup]2534&quot;]&apos;)' fallback='true' selected='false'/>
