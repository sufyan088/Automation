<step action='click' value='""' type='web' desc='Click on View Payment Details ' isThinkTime='false' isCommented='true' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='span(&quot;View Payment Details&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='heading3(5, _in(div({&apos;id&apos;:&apos;root&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='heading3(&quot;font-medium text-md tracking-tight[5]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;root&apos;]/article/main/article/section[2]/section/div[6]/div[1]/h3&quot;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/article/main/article/section[2]/section/div[6]/div/h3&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='heading3(5, _in(div(&quot;root&quot;)))' fallback='true' selected='false'/>
   <accessor type='Text' value='heading3(&quot;Failed[1]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Validate that open payment status is visible' isThinkTime='false' isCommented='true' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='span(&quot;Open&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='span(12, _in(div({&apos;id&apos;:&apos;root&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='span(&quot;font-bold text-success-foreground&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;root&apos;]/article/main/article/section[2]/div/div[1]/div/div/p[2]/span&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;font-bold text-success-foreground&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Open&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/article/main/article/section[2]/div/div/div/div/p[2]/span&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;root&apos;)/article[@class=&apos;flex min-h-screen flex-col&apos;]/main[@class=&apos;break-word flex-1 overflow-auto bg-background px-6 py-4 md:ml-16&apos;]/article[@class=&apos;w-full flex-1 bg-background&apos;]/section[2]/div[@class=&apos;rounded-lg border border-foreground bg-root text-card-foreground shadow-sm&apos;]/div[@class=&apos;flex-col space-y-1.5 p-6 flex gap-2&apos;]/div[@class=&apos;grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-2&apos;]/div[@class=&apos;grid grid-cols-3 text-lg&apos;]/p[@class=&apos;flex flex-col text-lg&apos;]/span[@class=&apos;font-bold text-success-foreground&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;flex-col space-y-1.5 p-6 flex gap-2&quot;] &gt; div[class=&quot;grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-2&quot;] &gt; div[class=&quot;grid grid-cols-3 text-lg&quot;] &gt; p[class=&quot;flex flex-col text-lg&quot;] &gt; span[class=&quot;font-bold text-success-foreground&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='span(12, _in(div(&quot;root&quot;)))' fallback='true' selected='false'/>
</dialect>
</step>
