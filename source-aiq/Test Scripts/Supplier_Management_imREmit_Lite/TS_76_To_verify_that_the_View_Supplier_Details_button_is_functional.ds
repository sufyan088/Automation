<step action='assertExists' value='""' type='web' desc='Vallidate that imREmit (lite) heading is visible' isThinkTime='false' isCommented='false' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='heading1(&quot;imREmit (lite)&quot;)' fallback='true' selected='true'/>
