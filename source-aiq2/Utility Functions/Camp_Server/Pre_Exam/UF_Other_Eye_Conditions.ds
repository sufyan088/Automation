<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'UF_Other_Eye_Conditions.ds' description= '' author= '' version= ''>
<dpl filename='' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='if' value='' type='web' desc='' isThinkTime='false' isCommented='true' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='isChecked(span(&quot;Other Eye Conditions&quot;))' fallback='true' selected='true'/>
</dialect>
</step>
<step action='log' value='"other eye conditions checkbox is checked"' type='web' desc='' isThinkTime='false' isCommented='true' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='' fallback='false' selected='true'/>
</dialect>
