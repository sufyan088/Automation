<step action='assertContainsText' value='"Customer Management"' type='web' desc='Validate the &quot;Customer&quot; link is visible' isThinkTime='false' isCommented='false' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='link(&quot;Customer Management&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='link(0, _in(nav({&apos;aria-label&apos;:&apos;Admin Subroute Navigation&apos;})))' fallback='true' selected='false'/>
