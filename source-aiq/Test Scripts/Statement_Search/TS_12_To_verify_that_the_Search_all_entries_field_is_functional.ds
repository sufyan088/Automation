   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[1]//td[1]//div[@class=&quot;w-fit whitespace-nowrap&quot;]&apos;).xy(0.75, 0.38 )' fallback='true' selected='false'/>
