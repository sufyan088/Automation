   <accessor type='unknown' value='textarea(&quot;comments&quot;,below(paragraph(&quot;Add a comment:&quot;)))' fallback='true' selected='true'/>
   <accessor type='unknown' value='div(&quot;space-y-2&quot;,below(paragraph(&quot;Add a comment:&quot;)))' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='' type='web' desc='Click on status' isThinkTime='false' isCommented='false' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='svg(&quot;lucide lucide-chevrons-up-down ml-2 size-4 shrink-0 opacity-50&quot;)' fallback='true' selected='true'/>
   <accessor type='unknown' value='span(&quot;Select Status&quot;)' fallback='true' selected='false'/>
   <accessor type='unknown' value='button(&quot;Select Status&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Click on Declined option' isThinkTime='false' isCommented='false' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='div(&quot;Declined&quot;)' fallback='true' selected='true'/>
   <accessor type='Id' value='span(&quot;radix-:rti:&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//span[@id=&apos;radix-:rti:&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div[5]/div/div/div/div/span[2]&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;radix-:rti:&apos;)&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathId' value='byXPath(&apos;//*[@id=&quot;radix-:rti:&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Text' value='span(&quot;Declined&quot;)' fallback='true' selected='false'/>
   <accessor type='unknown' value='Declined(&quot;Declined&quot;)' fallback='true' selected='false'/>
   <accessor type='unknown' value='svg(&quot;Declined&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='' isThinkTime='false' isCommented='false' isMasked='false' sequence='0'>
