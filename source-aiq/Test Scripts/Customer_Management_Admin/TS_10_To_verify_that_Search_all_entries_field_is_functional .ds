   <accessor type='unknown' value='textbox(&quot;placeholder==Search all entries...&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='"78,10"' type='web' desc='Validate searched values are visible ' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='div(&quot;Verizon Customer&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='div(31, _in(div({&apos;id&apos;:&apos;root&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='div(&quot;w-44[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;root&apos;]/article/main/article/section[2]/section/div[3]/div/table/tbody/tr[1]/td[7]/div&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;demobuyer@test.com&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/article/main/article/section[2]/section/div[3]/div/table/tbody/tr/td[7]/div&apos;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[1]//td[7]//div[@class=&quot;w-44&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[1]//td[7]//div[text()=&quot;demobuyer@test.com&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='div(31, _in(div(&quot;root&quot;)))' fallback='true' selected='false'/>
   <accessor type='Text' value='div(&quot;demobuyer@test.com&quot;)' fallback='true' selected='false'/>
   <accessor type='unknown' value='div(&quot;Granger_Test&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
