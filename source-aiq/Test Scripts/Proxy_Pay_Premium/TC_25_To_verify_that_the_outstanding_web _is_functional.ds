<step action='click' value='' type='web' desc='Click on Web Payments' isThinkTime='false' isCommented='true' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='paragraph(&quot;Web Payments&quot;)' fallback='true' selected='true'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='' isThinkTime='false' isCommented='false' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='heading3(&quot;Outstanding&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='heading3(0, _in(div({&apos;id&apos;:&apos;root&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='heading3(&quot;font-medium text-md tracking-tight&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;root&apos;]/article/main/article/section[2]/section/div[1]/div[1]/h3&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;tracking-tight text-md font-medium&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Outstanding&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/article/main/article/section[2]/section/div/div/h3&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;root&apos;)/article[@class=&apos;flex min-h-screen flex-col&apos;]/main[@class=&apos;break-word flex-1 overflow-auto bg-background px-6 py-4 md:ml-16&apos;]/article[@class=&apos;w-full flex-1 bg-background&apos;]/section[2]/section[@class=&apos;mb-4 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6&apos;]/div[@class=&apos;rounded-lg border border-foreground text-card-foreground shadow-sm cursor-pointer bg-root hover:border-theme hover:bg-muted&apos;]/div[@class=&apos;p-6 flex flex-row items-center justify-between space-y-0 pb-2&apos;]/h3[@class=&apos;tracking-tight text-md font-medium&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;section[class=&quot;mb-4 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6&quot;] &gt; div[class=&quot;rounded-lg border border-foreground text-card-foreground shadow-sm cursor-pointer bg-root hover:border-theme hover:bg-muted&quot;] &gt; div[class=&quot;p-6 flex flex-row items-center justify-between space-y-0 pb-2&quot;] &gt; h3[class=&quot;tracking-tight text-md font-medium&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='heading3(0, _in(div(&quot;root&quot;)))' fallback='true' selected='false'/>
</dialect>
