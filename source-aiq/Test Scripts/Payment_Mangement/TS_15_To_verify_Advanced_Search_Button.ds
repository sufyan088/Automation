   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;flex justify-between gap-4&quot;] &gt; div[class=&quot;flex flex-col justify-center gap-2 md:flex-row md:items-center&quot;] &gt; button[class=&quot;inline-flex items-center justify-center text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed ring-offset-background active:translate-y-px border border-input hover:bg-accent hover:text-accent-foreground px-3 rounded-md cursor-pointer font-sans h-8 gap-2 whitespace-nowrap border-dashed bg-root data-[state=open]:border-destructive-foreground data-[state=open]:bg-destructive data-[state=open]:text-destructive-foreground&quot;]&apos;)' fallback='true' selected='false'/>
