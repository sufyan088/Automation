    "report:iteration-matrix:customer-onboarding:last-failed:client": "node scripts/run-iteration-matrix-customer-onboarding-last-failed-client-report.js",
    "report:iteration-matrix:customer-onboarding-imremit-lite:client": "node scripts/run-iteration-matrix-customer-onboarding-imremit-lite-client-report.js",
