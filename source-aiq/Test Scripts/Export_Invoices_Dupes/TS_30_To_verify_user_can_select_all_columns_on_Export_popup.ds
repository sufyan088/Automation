<step action='click' value='""' type='web' desc='Click on Export Duplicate Results' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='submit(&quot;Export Duplicate Results&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//main[@id=&apos;root&apos;]/article/main/article/div[2]/div/div[1]/div[1]/div[2]/button&quot;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/main/article/main/article/div[2]/div/div/div/div[2]/button&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;root&apos;)/article[@class=&apos;flex min-h-screen flex-col&apos;]/main[@class=&apos;break-word flex-1 overflow-auto bg-background px-6 py-4 md:ml-16&apos;]/article[@class=&apos;w-full flex-1 bg-background&apos;]/div[@class=&apos;w-full py-2&apos;]/div[@class=&apos;rounded-lg border bg-root text-card-foreground mx-0 w-full border-border/40 shadow-sm&apos;]/div[@class=&apos;space-y-1.5 p-6 flex flex-col gap-4 bg-muted/30 pb-2&apos;]/div[@class=&apos;flex flex-col justify-between gap-4 md:flex-row md:items-start&apos;]/div[@class=&apos;hidden flex-wrap items-start justify-end gap-2 md:flex&apos;]/button[@class=&apos;inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed ring-offset-background active:translate-y-px bg-primary text-root hover:bg-primary/80 h-10 py-2 px-4 gap-2&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;rounded-lg border bg-root text-card-foreground mx-0 w-full border-border/40 shadow-sm&quot;] &gt; div[class=&quot;space-y-1.5 p-6 flex flex-col gap-4 bg-muted/30 pb-2&quot;] &gt; div[class=&quot;flex flex-col justify-between gap-4 md:flex-row md:items-start&quot;] &gt; div[class=&quot;hidden flex-wrap items-start justify-end gap-2 md:flex&quot;] &gt; button[class=&quot;inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed ring-offset-background active:translate-y-px bg-primary text-root hover:bg-primary/80 h-10 py-2 px-4 gap-2&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='submit(&quot;active:translate-y-px bg-primary disabled:cursor-not-allowed disabled:opacity-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-ring font-medium gap-2 h-10 hover:bg-primary/80 inline-flex items-center justify-center px-4 py-2 ring-offset-background rounded-md text-root text-sm transition-colors[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='Text' value='submit(&quot;Export Duplicate Results[1]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
