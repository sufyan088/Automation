<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'To_Verify_That_Alert_Message_Should_Be_Displayed_When_Participant_First_Name_Text_Field_Is_Empty.ds' description= '' author= '' version= ''>
<dpl filename='' exectype='runstepbystep' errorhandling='' type='HashDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='assertExists' value='"113,14"' type='web' desc='Verify that participant First Name cannot be left blank' isThinkTime='false' isCommented='false' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='div(&quot;First Name cannot be left blank.&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='div(2, _in(div({&apos;id&apos;:&apos;toast-container&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='div(&quot;toast-title&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;toast-container&apos;]/div/div[2]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;toast-title&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;First Name cannot be left blank.&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div[5]/div/div[2]&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;toast-container&apos;)/div[@class=&apos;toast toast-error&apos;]/div[@class=&apos;toast-title&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;toast-bottom-right&quot;] &gt; div[class=&quot;toast toast-error&quot;] &gt; div[class=&quot;toast-title&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#toast-container &gt; .toast.toast-error &gt; .toast-title&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='div(2, _in(div(&quot;toast-container&quot;)))' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>