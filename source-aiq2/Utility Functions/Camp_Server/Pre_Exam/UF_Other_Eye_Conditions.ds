</dialect>
</step>
<step action='setChecked' value='true' type='web' desc='Check other eye conditions checkbox' isThinkTime='false' isCommented='false' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='span(&quot;Other Eye Conditions&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='span(1, _in(section({&apos;id&apos;:&apos;step3&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='span(&quot;label-text[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//section[@id=&apos;step3&apos;]/div[1]/div/table/tbody/tr[1]/td[2]/label[1]/span&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Other Eye Conditions&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/form/section[3]/div/div/table/tbody/tr/td[2]/label/span&apos;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[1]//td[2]//label//span[text()=&quot;Other Eye Conditions&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='span(1, _in(section(&quot;step3&quot;)))' fallback='true' selected='false'/>
</dialect>
</step>
<step action='log' value='"other eye conditions checkbox is checked"' type='web' desc='' isThinkTime='false' isCommented='true' isMasked='false' sequence='0'>
