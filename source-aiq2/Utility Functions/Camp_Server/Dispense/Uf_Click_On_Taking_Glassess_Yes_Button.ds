<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'To_Verify_That_Not_Taking_Dropdown_Should_Be_Disabled_When_VS_Glasses_Taking_Button_Is_Clicked.ds' description= '' author= '' version= ''>
<dpl filename='' exectype='runstepbystep' errorhandling='' type='HashDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='click' value='""' type='web' desc='Click on taking glasses button' isThinkTime='false' isCommented='false' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='span(&quot;Taking&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='span(1, _in(section({&apos;id&apos;:&apos;step1&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='span(&quot;label-text&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//section[@id=&apos;step1&apos;]/div[3]/div[1]/div[1]/label/span&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;label-text&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Not Taking&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/form/section/div[3]/div/div/label/span&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;step1&apos;)/div[@class=&apos;row rowmb18&apos;]/div[@class=&apos;col-md-4 form-group mb-2&apos;]/div[@class=&apos;form-check&apos;]/label[@class=&apos;toggle mb10x&apos;]/span[@class=&apos;label-text&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;row rowmb18&quot;] &gt; div[class=&quot;col-md-4 form-group mb-2&quot;] &gt; div[class=&quot;form-check&quot;] &gt; label[class=&quot;toggle mb10x&quot;] &gt; span[class=&quot;label-text&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;.row.rowmb18 &gt; .col-md-4.form-group.mb-2 &gt; .form-check &gt; .toggle.mb10x &gt; .label-text&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='span(1, _in(section(&quot;step1&quot;)))' fallback='true' selected='false'/>
   <accessor type='Text' value='span(&quot;Not Taking&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>