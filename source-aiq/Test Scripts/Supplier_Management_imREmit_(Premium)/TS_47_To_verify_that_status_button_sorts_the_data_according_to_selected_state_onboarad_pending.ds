   <accessor type='unknown' value='button(&quot;Status&quot;)' fallback='true' selected='true'/>
</dialect>
</step>
<step action='setChecked' value='true' type='web' desc='Click on Onboarding Pending ' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='span(&quot;Onboarding Pending&quot;)' fallback='true' selected='true'/>
   <accessor type='unknown' value='span(&quot;Active&quot;)' fallback='true' selected='false'/>
   <accessor type='unknown' value='span(&quot;Inactive&quot;)' fallback='true' selected='false'/>
   <accessor type='unknown' value='span(&quot;Declined Enrollment&quot;)' fallback='true' selected='false'/>
   <accessor type='unknown' value='span(&quot;Approval Pending&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='"47,13"' type='web' desc='Validate ONBOARDING PENDING Status are shown' isThinkTime='false' isCommented='true' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='div(&quot;ONBOARDING PENDING&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='div(57, _in(div({&apos;id&apos;:&apos;root&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='div(&quot;w-44[16]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;root&apos;]/article/main/article/section[3]/div[3]/div/table/tbody/tr[2]/td[8]/div&quot;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/article/main/article/section[3]/div[3]/div/table/tbody/tr[2]/td[8]/div&apos;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[2]//td[8]//div[@class=&quot;w-44&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[2]//td[8]//div[text()=&quot;ONBOARDING PENDING&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='div(57, _in(div(&quot;root&quot;)))' fallback='true' selected='false'/>
   <accessor type='Text' value='div(&quot;ONBOARDING PENDING[1]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
