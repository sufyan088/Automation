<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TS_84_To_verify_that_the_Status_button_sorts_the_data_according_to_the_selected_state_Approval_pending.ds' description= '' author= 'null' version= ''>
<dpl filename='{ds}/../../Resources/IM_DPL1.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='setShadowDOM' value='true' type='web' desc='' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='' fallback='false' selected='true'/>
</dialect>
</step>
