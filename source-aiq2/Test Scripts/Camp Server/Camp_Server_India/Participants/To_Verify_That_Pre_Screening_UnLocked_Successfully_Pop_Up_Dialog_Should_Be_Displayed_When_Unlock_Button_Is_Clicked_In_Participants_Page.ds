<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'To_Verify_That_Pre_Screening_UnLocked_Successfully_Pop_Up_Dialog_Should_Be_Displayed_When_Unlock_Button_Is_Clicked_In_Participants_Page.ds' description= '' author= '' version= ''>
<dpl filename='{ds}/../../../../Resources/Digit_Eyes_JS_DPL.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='en_US'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='' type='web' desc='Login to Camp Server, Registration, Pre Screening, Pre Exam.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../Examination/To_Verify_That_Participant_Should_Be_Refered_To_Further_Examination_Screen_When_No_Button_Is_Clicked.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='Click on Participants.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='link(&quot;Participants&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='link(8, _in(div({&apos;id&apos;:&apos;navbars&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='link(&quot;nav-link[8]&quot;)' fallback='true' selected='false'/>
   <accessor type='AttrHref' value='link(&quot;patients.php&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;navbars&apos;]/ul/li[9]/a&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Participants&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/nav/div/div/ul/li[9]/a&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;a[href=&quot;patients.php&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='link(8, _in(div(&quot;navbars&quot;)))' fallback='true' selected='false'/>
   <accessor type='Text' value='link(&quot;Participants[1]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='' type='web' desc='Click on Participant name.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='cell($Participant_Name)' fallback='true' selected='true'/>
   <accessor type='unknown' value='cell()' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='Click on pre screening unlock button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Id' value='button(&quot;btnPreUnlock&quot;)' fallback='true' selected='true'/>
   <accessor type='AttrClass' value='button(&quot;btn btn-primary btn-sm[2]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathName' value='byXPath(&apos;//*[@name=&quot;btnPreUnlock&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrName' value='button(&quot;btnPreUnlock&quot;)' fallback='true' selected='false'/>
   <accessor type='Text' value='button(&quot;Unlock&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//button[@id=&apos;btnPreUnlock&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot; Unlock&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/div[4]/div[2]/button&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;btnPreUnlock&apos;)&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;container-fluid main-container mb-5 pt-0&quot;] &gt; div[class=&quot;col-md-12xxx contentxxx&quot;] &gt; div[class=&quot;row rowmb18 bg-prescreening py-1&quot;] &gt; div[class=&quot;col-3 text-end&quot;] &gt; button[class=&quot;btn btn-sm btn-primary&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#btnPreUnlock&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;button[name=&quot;btnPreUnlock&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathId' value='byXPath(&apos;//*[@id=&quot;btnPreUnlock&quot;]&apos;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='"81,25"' type='web' desc='Verify that Success popup alert message : Pre-Screening Unlocked Successfully' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='div([&quot;Pre-Screening Unlocked Successfully&quot;])' fallback='true' selected='true'/>
   <accessor type='Parent' value='div(2, _in(div({&apos;id&apos;:&apos;toast-container&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='div(&quot;toast-title&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;toast-container&apos;]/div/div[2]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;toast-title&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Pre-Screening Unlocked Successfully!&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div[6]/div/div[2]&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;toast-container&apos;)/div[@class=&apos;toast toast-success&apos;]/div[@class=&apos;toast-title&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;body[class=&quot;modal-open&quot;] &gt; div[class=&quot;toast-bottom-right&quot;] &gt; div[class=&quot;toast toast-success&quot;] &gt; div[class=&quot;toast-title&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#toast-container &gt; .toast.toast-success &gt; .toast-title&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='div(2, _in(div(&quot;toast-container&quot;)))' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>