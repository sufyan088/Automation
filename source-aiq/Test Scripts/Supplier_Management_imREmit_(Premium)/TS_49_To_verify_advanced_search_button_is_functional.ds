   <accessor type='unknown' value='span(&quot;Onboarding Pending&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='' type='web' desc='Click on advanced search button' isThinkTime='false' isCommented='false' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='span(&quot;Advanced Search&quot;)' fallback='true' selected='true'/>
   <accessor type='unknown' value='span(&quot;Active&quot;)' fallback='true' selected='false'/>
   <accessor type='unknown' value='span(&quot;Inactive&quot;)' fallback='true' selected='false'/>
   <accessor type='unknown' value='span(&quot;Declined Enrollment&quot;)' fallback='true' selected='false'/>
   <accessor type='unknown' value='span(&quot;Approval Pending&quot;)' fallback='true' selected='false'/>
   <accessor type='unknown' value='span(&quot;Onboarding Pending&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='' isThinkTime='false' isCommented='false' isMasked='false' sequence='0'>
