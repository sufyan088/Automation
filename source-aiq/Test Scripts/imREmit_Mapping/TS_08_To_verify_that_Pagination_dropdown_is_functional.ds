<step action='click' value='' type='web' desc='Click on pagination dropdown.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='svg(&quot;class==lucide lucide-chevrons-up-down ml-2 size-4 shrink-0 opacity-50&quot;,leftOf(textbox(&quot;placeholder==Search all entries...&quot;,)))' fallback='true' selected='true'/>
   <accessor type='Parent' value='svg(15, _in(div(&quot;root&quot;)))' fallback='true' selected='false'/>
   <accessor type='Parent' value='svg(15, _in(div({&apos;id&apos;:&apos;root&apos;})))' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;lucide lucide-chevrons-up-down ml-2 size-4 shrink-0 opacity-50&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;space-y-4&quot;] &gt; div[class=&quot;flex justify-between gap-4&quot;] &gt; div[class=&quot;flex flex-wrap items-end gap-2&quot;] &gt; button[class=&quot;inline-flex items-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed ring-offset-background active:translate-y-px border border-input bg-root hover:bg-accent/70 hover:text-accent-foreground hover:border-muted-foreground h-10 py-2 px-4 cursor-pointer font-sans justify-between w-[80px]&quot;] &gt; svg[class=&quot;lucide lucide-chevrons-up-down ml-2 size-4 shrink-0 opacity-50&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='svg(&quot;lucide lucide-chevrons-up-down ml-2 opacity-50 shrink-0 size-4&quot;)' fallback='true' selected='false'/>
   <accessor type='unknown' value='svg(&quot;class==lucide lucide-chevrons-up-down ml-2 size-4 shrink-0 opacity-50&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
