<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'To_Verify_That_ Pre_Screening_Page_Should_Be_Displayed_When_Participants_Is_Clicked.ds' description= '' author= '' version= ''>
<dpl filename='{ds}/../../../../Resources/Digit_Eyes_JS_DPL.csv' exectype='runstepbystep' errorhandling='' type='HashDPL' locale='null'/>
<fallback useFallback='false'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='' type='web' desc='Register participant script' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../Registration/To_Verify_That_Success_Pop_Dialog_Message_Should_Be_Displayed_When_Participants_Is_Successfully_Registered.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='""' type='web' desc='click on dashboad button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../Utility Functions/Camp_Server/Registration/UF_Click_On_Dashboard.ds"' fallback='true' selected='true'/>
   <accessor type='Parent' value='button(2, _in(div({&apos;id&apos;:&apos;divRegSuccess&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='button(&quot;btn btn-primary btn-sm mb-1[2]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;divRegSuccess&apos;]/div/div/div/div[2]/div/button[3]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot; Dashboard&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div[2]/div/div/div/div[2]/div/button[3]&apos;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='button({&apos;onclick&apos;:&quot;location.href=&apos;dashboard.php&apos;&quot;})' fallback='true' selected='false'/>
   <accessor type='Parent' value='button(2, _in(div(&quot;divRegSuccess&quot;)))' fallback='true' selected='false'/>
   <accessor type='Text' value='button(&quot;Dashboard&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='""' type='web' desc='Click on Prescreening button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../Utility Functions/Camp_Server/Pre_Screening/UF_Click_On_Pre_Screening_Button.ds"' fallback='true' selected='true'/>
   <accessor type='Parent' value='link(3, _in(div({&apos;id&apos;:&apos;navbars&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='link(&quot;nav-link[3]&quot;)' fallback='true' selected='false'/>
   <accessor type='AttrHref' value='link(&quot;prescreening.php&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;navbars&apos;]/ul/li[4]/a&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Pre-Screening&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/nav/div/div/ul/li[4]/a&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;a[href=&quot;prescreening.php&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='link(3, _in(div(&quot;navbars&quot;)))' fallback='true' selected='false'/>
   <accessor type='Text' value='link(&quot;Pre-Screening&quot;)' fallback='true' selected='false'/>
   <accessor type='unknown' value='"REPOSITORY/VisionSpring/DigitEYES-VisionSpring/Utility Functions/Camp_Server/Pre_Screening/UF_Click_On_Pre_Screening_Button.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='log' value='$Participant_Name' type='web' desc='Print Participants ID' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='' fallback='false' selected='true'/>
</dialect>
</step>
<step action='click' value='' type='web' desc='click on Created participants ' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='cell($Participant_Name)' fallback='true' selected='true'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify prescreening is displayed' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='bold(&quot;Pre-Screening&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&apos;//nav/div/a/b&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot; Pre-Screening&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/nav/div/a/b&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;/html[1]/body[1]/nav[@class=&apos;navbar navbar-expand-md navbar-dark bg-prescreening&apos;]/div[@class=&apos;container-fluid&apos;]/a[@class=&apos;navbar-brand&apos;]/b[1]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>