<testcase   name= 'TS_02_To_verify_that_Go_to_next_page_button_is_functional.ds' description= '' author= 'null' version= ''>
<dpl filename='REPOSITORY/IM/Resources/IM_DPL1.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='en_US'/>
