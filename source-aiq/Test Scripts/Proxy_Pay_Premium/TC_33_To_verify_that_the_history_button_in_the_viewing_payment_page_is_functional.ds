<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_33_To_verify_that_the_history_button_in_the_viewing_payment_page_is_functional.ds' description= '' author= '' version= ''>
<dpl filename='{ds}/../../Resources/IM_DPL1.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
