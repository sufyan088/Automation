   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/form/section/div/div/table/tbody/tr[4]/td[4]/label/span&apos;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[4]//td[4]//label//span[@class=&quot;label-text&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='span(11, _in(section(&quot;step1&quot;)))' fallback='true' selected='false'/>
