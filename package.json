{
  "name": "vision-spring-playwright",
  "version": "1.0.0",
  "description": "Iteration Matrix Playwright Test Automation Framework",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "allure:clean-results": "node -e \"const fs=require('fs'); fs.rmSync('allure-results',{recursive:true,force:true}); fs.mkdirSync('allure-results',{recursive:true});\"",
    "framework:bundle": "node scripts/build-framework-bundle.js",
    "framework:bundle:zip": "powershell -NoProfile -Command \"$zip='framework-team-starter-kit.zip'; if (Test-Path $zip) { Remove-Item $zip -Force }; Compress-Archive -Path 'framework\\team-starter-kit\\*' -DestinationPath $zip -Force\"",
    "scaffold:iteration-matrix": "node scripts/bootstrap-iteration-matrix-structure.js",
    "scaffold:module": "node scripts/scaffold-module.js",
    "test:iteration-matrix": "playwright test \"tests/Iteration_Matrix\" --workers=3",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --headed --debug",
    "report": "playwright show-report",
    "allure:brand": "node scripts/customize-allure-report.js",
    "allure:normalize": "node scripts/normalize-allure-suites.js",
    "report:iteration-matrix:client": "node scripts/run-iteration-matrix-client-report.js",
    "report:iteration-matrix:card-on-file:client": "node scripts/run-iteration-matrix-card-on-file-client-report.js",
    "report:iteration-matrix:customer-management-admin-new:client": "node scripts/run-iteration-matrix-customer-management-admin-new-client-report.js",
    "report:iteration-matrix:criteria-settings:client": "node scripts/run-iteration-matrix-criteria-settings-client-report.js",
    "report:iteration-matrix:criteria-settings:last-failed:client": "node scripts/run-iteration-matrix-criteria-settings-last-failed-client-report.js",
    "report:iteration-matrix:customer-management-admin-new:last-failed:client": "node scripts/run-iteration-matrix-customer-management-admin-new-last-failed-client-report.js",
    "report:iteration-matrix:last-failed:client": "node scripts/run-iteration-matrix-last-failed-client-report.js",
    "legacy:scaffold:source-aiq": "node scripts/bootstrap-aiq-structure.js",
    "legacy:scaffold:source-aiq2": "node scripts/bootstrap-source-aiq2-structure.js",
    "legacy:test:all": "playwright test \"tests/DigitEYESCamp_Cluster/DigitEYESCamps_ManageCampsCluster\" \"tests/DigitEYESCamp_Cluster/DigitEYESCamps_DataForSalesforce\" \"tests/DigitEYESCamp_Cluster/DigitEYESCamps_Participants\" \"tests/DigitEYESCamp_Cluster/DigitEYESDataLoader_DataForSalesForce\" \"tests/DigitEYESCamp_Cluster/DigitEYESDataLoader_ParticipantConsents\" \"tests/DigitEYESCamp_Cluster/DigitEYESDataLoader_SFDataLoaderChangeLog\" \"tests/DigitEYESCamp_Cluster/DigitEYESDataLoader_SFDataLoaderErrorCases\" \"tests/DigitEYESCamp_Cluster/DigitEYESDataLoader_SFDataLoaderQueue\" \"tests/DigitEYESCamp_Cluster/DigitEYESReporting_CampTrends\" \"tests/DigitEYESCamp_Cluster/DigitEYESReporting_InternetAvailability\" \"tests/DigitEYESCamp_Cluster/DigitEYESReporting_PopinAvailability\" \"tests/DigitEYESCamp_Cluster/DigitEYESReporting_SummarySheetData\" \"tests/DigitEYESCamp_Cluster/DigitEYESReporting_WorkReportIPTeams\" \"tests/DigitEYESCamp_Cluster/DigitEYESReporting_WorkReportVSTeams\" \"tests/DigitEYESCamp_Cluster/DigitEYESSettings_CountrySettings\" \"tests/DigitEYESCamp_Cluster/DigitEYESSettings_DESalesforceFieldMapping\" \"tests/DigitEYESCamp_Cluster/DigitEYESSettings_Hospitals\" \"tests/DigitEYESCamp_Cluster/DigitEYESSettings_ImplementationPartners\" --workers=3",
    "legacy:test:camps": "playwright test \"tests/DigitEYESCamp_Cluster/DigitEYESCamps_ManageCampsCluster\" \"tests/DigitEYESCamp_Cluster/DigitEYESCamps_DataForSalesforce\" \"tests/DigitEYESCamp_Cluster/DigitEYESCamps_Participants\" --workers=3",
    "legacy:test:dataloader": "playwright test \"tests/DigitEYESCamp_Cluster/DigitEYESDataLoader_DataForSalesForce\" \"tests/DigitEYESCamp_Cluster/DigitEYESDataLoader_ParticipantConsents\" \"tests/DigitEYESCamp_Cluster/DigitEYESDataLoader_SFDataLoaderChangeLog\" \"tests/DigitEYESCamp_Cluster/DigitEYESDataLoader_SFDataLoaderErrorCases\" \"tests/DigitEYESCamp_Cluster/DigitEYESDataLoader_SFDataLoaderQueue\" --workers=3",
    "legacy:test:reporting": "playwright test \"tests/DigitEYESCamp_Cluster/DigitEYESReporting_CampTrends\" \"tests/DigitEYESCamp_Cluster/DigitEYESReporting_InternetAvailability\" \"tests/DigitEYESCamp_Cluster/DigitEYESReporting_PopinAvailability\" \"tests/DigitEYESCamp_Cluster/DigitEYESReporting_SummarySheetData\" \"tests/DigitEYESCamp_Cluster/DigitEYESReporting_WorkReportIPTeams\" \"tests/DigitEYESCamp_Cluster/DigitEYESReporting_WorkReportVSTeams\" --workers=3",
    "legacy:test:settings": "playwright test \"tests/DigitEYESCamp_Cluster/DigitEYESSettings_CountrySettings\" \"tests/DigitEYESCamp_Cluster/DigitEYESSettings_DESalesforceFieldMapping\" \"tests/DigitEYESCamp_Cluster/DigitEYESSettings_Hospitals\" \"tests/DigitEYESCamp_Cluster/DigitEYESSettings_ImplementationPartners\" --workers=3",
    "legacy:test:manage-camps-cluster": "playwright test \"tests/DigitEYESCamp_Cluster/DigitEYESCamps_ManageCampsCluster\" --workers=3",
    "legacy:test:camps-dataforsalesforce": "playwright test \"tests/DigitEYESCamp_Cluster/DigitEYESCamps_DataForSalesforce\" --workers=3",
    "legacy:test:camps-participants": "playwright test \"tests/DigitEYESCamp_Cluster/DigitEYESCamps_Participants\" --workers=3",
    "legacy:test:dataforsalesforce": "playwright test \"tests/DigitEYESCamp_Cluster/DigitEYESDataLoader_DataForSalesForce\" --workers=3",
    "legacy:test:participant-consents": "playwright test \"tests/DigitEYESCamp_Cluster/DigitEYESDataLoader_ParticipantConsents\" --workers=3",
    "legacy:test:change-log": "playwright test \"tests/DigitEYESCamp_Cluster/DigitEYESDataLoader_SFDataLoaderChangeLog\" --workers=3",
    "legacy:test:errorcases": "playwright test \"tests/DigitEYESCamp_Cluster/DigitEYESDataLoader_SFDataLoaderErrorCases\" --workers=3",
    "legacy:test:queue": "playwright test \"tests/DigitEYESCamp_Cluster/DigitEYESDataLoader_SFDataLoaderQueue\" --workers=3",
    "legacy:test:camp-trends": "playwright test \"tests/DigitEYESCamp_Cluster/DigitEYESReporting_CampTrends\" --workers=3",
    "legacy:test:internet-availability": "playwright test \"tests/DigitEYESCamp_Cluster/DigitEYESReporting_InternetAvailability\" --workers=3",
    "legacy:test:popin-availability": "playwright test \"tests/DigitEYESCamp_Cluster/DigitEYESReporting_PopinAvailability\" --workers=3",
    "legacy:test:summary-sheet": "playwright test \"tests/DigitEYESCamp_Cluster/DigitEYESReporting_SummarySheetData\" --workers=3",
    "legacy:test:work-report-ip": "playwright test \"tests/DigitEYESCamp_Cluster/DigitEYESReporting_WorkReportIPTeams\" --workers=3",
    "legacy:test:work-report-vs": "playwright test \"tests/DigitEYESCamp_Cluster/DigitEYESReporting_WorkReportVSTeams\" --workers=3",
    "legacy:test:country-settings": "playwright test \"tests/DigitEYESCamp_Cluster/DigitEYESSettings_CountrySettings\" --workers=3",
    "legacy:test:salesforce-mapping": "playwright test \"tests/DigitEYESCamp_Cluster/DigitEYESSettings_DESalesforceFieldMapping\" --workers=3",
    "legacy:test:hospitals": "playwright test \"tests/DigitEYESCamp_Cluster/DigitEYESSettings_Hospitals\" --workers=3",
    "legacy:test:implementation-partners": "playwright test \"tests/DigitEYESCamp_Cluster/DigitEYESSettings_ImplementationPartners\" --workers=3",
    "legacy:test:camp-server": "node scripts/run-camp-server-sequence.js",
    "legacy:test:camp-server-login": "playwright test \"tests/DigitEYESCamp_Server/Camp_Server_Login\" --workers=1",
    "legacy:test:camp-server-registration": "playwright test \"tests/DigitEYESCamp_Server/01_Camp_Server_India_Registration\" --workers=1",
    "legacy:test:camp-server-prescreening": "playwright test \"tests/DigitEYESCamp_Server/02_Camp_Server_India_Prescreening\" --workers=1",
    "legacy:test:camp-server-preexam": "playwright test \"tests/DigitEYESCamp_Server/03_Camp_Server_India_PreExam\" --workers=1",
    "legacy:test:camp-server-examination": "playwright test \"tests/DigitEYESCamp_Server/04_Camp_Server_India_Examination\" --workers=1",
    "legacy:test:camp-server-opthalm": "playwright test \"tests/DigitEYESCamp_Server/05_Camp_Server_India_Opthalm\" --workers=1",
    "legacy:test:camp-server-dispense": "playwright test \"tests/DigitEYESCamp_Server/06_Camp_Server_India_Dispense\" --workers=1",
    "legacy:test:camp-server-participants": "playwright test \"tests/DigitEYESCamp_Server/07_Camp_Server_India_Participants\" --workers=1",
    "legacy:test:camp-server-summary": "playwright test \"tests/DigitEYESCamp_Server/08_Camp_Server_India_Summary\" --workers=1",
    "legacy:report:combined:parallel": "npm run allure:clean-results && playwright test \"tests/DigitEYESCamp_Cluster/DigitEYESCamps_ManageCampsCluster\" \"tests/DigitEYESCamp_Cluster/DigitEYESCamps_DataForSalesforce\" \"tests/DigitEYESCamp_Cluster/DigitEYESCamps_Participants\" \"tests/DigitEYESCamp_Cluster/DigitEYESDataLoader_DataForSalesForce\" \"tests/DigitEYESCamp_Cluster/DigitEYESDataLoader_ParticipantConsents\" \"tests/DigitEYESCamp_Cluster/DigitEYESDataLoader_SFDataLoaderChangeLog\" \"tests/DigitEYESCamp_Cluster/DigitEYESDataLoader_SFDataLoaderErrorCases\" \"tests/DigitEYESCamp_Cluster/DigitEYESDataLoader_SFDataLoaderQueue\" \"tests/DigitEYESCamp_Cluster/DigitEYESReporting_CampTrends\" \"tests/DigitEYESCamp_Cluster/DigitEYESReporting_InternetAvailability\" \"tests/DigitEYESCamp_Cluster/DigitEYESReporting_PopinAvailability\" \"tests/DigitEYESCamp_Cluster/DigitEYESReporting_SummarySheetData\" \"tests/DigitEYESCamp_Cluster/DigitEYESReporting_WorkReportIPTeams\" \"tests/DigitEYESCamp_Cluster/DigitEYESReporting_WorkReportVSTeams\" \"tests/DigitEYESCamp_Cluster/DigitEYESSettings_CountrySettings\" \"tests/DigitEYESCamp_Cluster/DigitEYESSettings_DESalesforceFieldMapping\" \"tests/DigitEYESCamp_Cluster/DigitEYESSettings_Hospitals\" \"tests/DigitEYESCamp_Cluster/DigitEYESSettings_ImplementationPartners\" --workers=3 --reporter=allure-playwright && npm run allure:normalize && node scripts/strip-source-aiq-from-allure-results.js && npx allure generate allure-results --clean -o Result/allure-report-combined && node scripts/customize-allure-report.js Result/allure-report-combined",
    "legacy:report:combined:parallel:portable": "npm run allure:normalize && node scripts/strip-source-aiq-from-allure-results.js && npx allure generate allure-results --clean --single-file -o Result/allure-report-combined-single && node scripts/customize-allure-report.js Result/allure-report-combined-single",
    "legacy:report:combined:share": "npm run allure:clean-results && playwright test \"tests/DigitEYESCamp_Cluster/DigitEYESCamps_ManageCampsCluster\" \"tests/DigitEYESCamp_Cluster/DigitEYESCamps_DataForSalesforce\" \"tests/DigitEYESCamp_Cluster/DigitEYESCamps_Participants\" \"tests/DigitEYESCamp_Cluster/DigitEYESDataLoader_DataForSalesForce\" \"tests/DigitEYESCamp_Cluster/DigitEYESDataLoader_ParticipantConsents\" \"tests/DigitEYESCamp_Cluster/DigitEYESDataLoader_SFDataLoaderChangeLog\" \"tests/DigitEYESCamp_Cluster/DigitEYESDataLoader_SFDataLoaderErrorCases\" \"tests/DigitEYESCamp_Cluster/DigitEYESDataLoader_SFDataLoaderQueue\" \"tests/DigitEYESCamp_Cluster/DigitEYESReporting_CampTrends\" \"tests/DigitEYESCamp_Cluster/DigitEYESReporting_InternetAvailability\" \"tests/DigitEYESCamp_Cluster/DigitEYESReporting_PopinAvailability\" \"tests/DigitEYESCamp_Cluster/DigitEYESReporting_SummarySheetData\" \"tests/DigitEYESCamp_Cluster/DigitEYESReporting_WorkReportIPTeams\" \"tests/DigitEYESCamp_Cluster/DigitEYESReporting_WorkReportVSTeams\" \"tests/DigitEYESCamp_Cluster/DigitEYESSettings_CountrySettings\" \"tests/DigitEYESCamp_Cluster/DigitEYESSettings_DESalesforceFieldMapping\" \"tests/DigitEYESCamp_Cluster/DigitEYESSettings_Hospitals\" \"tests/DigitEYESCamp_Cluster/DigitEYESSettings_ImplementationPartners\" --workers=3 --reporter=allure-playwright && npm run allure:normalize && node scripts/strip-source-aiq-from-allure-results.js && npx allure generate allure-results --clean --single-file -o Result/allure-report-combined-shareable && node scripts/customize-allure-report.js Result/allure-report-combined-shareable",
    "legacy:report:camp-server:client": "node scripts/run-camp-server-client-report.js",
    "legacy:report:camp-server:last-failed:client": "node scripts/run-camp-server-last-failed-client-report.js",
    "legacy:report:camp-server-registration:client": "node scripts/run-camp-server-registration-client-report.js",
    "legacy:report:camp-cluster:client": "node scripts/run-combined-client-report.js",
    "legacy:report:camp-cluster:last-failed:client": "node scripts/run-camp-cluster-last-failed-client-report.js",
    "legacy:report:camp-cluster-participants:client": "node scripts/run-camp-cluster-participants-client-report.js",
    "legacy:report:combined:share:zip": "powershell -NoProfile -Command \"$zip='Result\\allure-report-combined-shareable.zip'; if (Test-Path $zip) { Remove-Item $zip -Force }; Compress-Archive -Path 'Result\\allure-report-combined-shareable\\*' -DestinationPath $zip -Force\"",
    "legacy:report:combined:client": "node scripts/run-combined-client-report.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "allure-commandline": "^2.38.1",
    "allure-playwright": "^3.6.0"
  }
}
