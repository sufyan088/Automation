<step action='assertExists' value='' type='web' desc='Validate Go to first page button is visible' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='svg(&quot;lucide lucide-arrow-right-from-line size-4&quot;)' fallback='true' selected='true'/>
   <accessor type='unknown' value='path([&quot;M3 12h14&quot;])' fallback='true' selected='false'/>
   <accessor type='unknown' value='submit(&quot;data-state==closed&quot;,above(span([&quot;pointer-events&quot;])))' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='Click on Go to last page button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='svg(&quot;lucide lucide-arrow-right-from-line size-4&quot;)' fallback='true' selected='true'/>
   <accessor type='AttrClass' value='submit(&quot;active:translate-y-px bg-primary disabled:cursor-not-allowed disabled:opacity-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-ring font-medium h-10 hidden hover:bg-primary/90 items-center justify-center lg:flex px-4 py-2 ring-offset-background rounded-md text-root text-sm transition-colors&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;root&apos;]/article/main/article/section[2]/section/div[1]/div[1]/button[7]&quot;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/article/main/article/section[2]/section/div/div/button[7]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='submit(&quot;active:translate-y-px bg-primary disabled:cursor-not-allowed disabled:opacity-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-ring font-medium h-10 hidden hover:bg-primary/90 items-center justify-center lg:flex px-4 py-2 ring-offset-background rounded-md text-root text-sm transition-colors&quot;)' fallback='true' selected='false'/>
   <accessor type='Text' value='submit(&quot;Go to last page&quot;)' fallback='true' selected='false'/>
   <accessor type='unknown' value='path([&quot;M21 12H7&quot;])' fallback='true' selected='false'/>
   <accessor type='unknown' value='submit(&quot;data-state==closed&quot;,above(span(&quot;Start Date&quot;)))' fallback='true' selected='false'/>
</dialect>
</step>
