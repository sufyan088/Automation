   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;root&apos;)/article[@class=&apos;flex min-h-screen flex-col&apos;]/main[@class=&apos;break-word flex-1 overflow-auto bg-background px-6 py-4 md:ml-16&apos;]/article[@class=&apos;w-full flex-1 bg-background&apos;]/div[@class=&apos;space-y-2&apos;]/form[1]/div[@class=&apos;flex justify-between gap-4&apos;]/div[@class=&apos;flex flex-col justify-center gap-2 md:flex-row md:items-center&apos;]/button[@class=&apos;inline-flex items-center justify-center text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed ring-offset-background active:translate-y-px border border-input hover:bg-accent hover:text-accent-foreground px-3 rounded-md cursor-pointer font-sans h-8 gap-2 whitespace-nowrap border-dashed bg-root data-[state=open]:border-destructive-foreground data-[state=open]:bg-destructive data-[state=open]:text-destructive-foreground&apos;]&quot;)' fallback='true' selected='false'/>
