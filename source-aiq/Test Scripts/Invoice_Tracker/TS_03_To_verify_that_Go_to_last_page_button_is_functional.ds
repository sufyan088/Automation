<step action='include' value='' type='web' desc='Click on &quot;Invoice Tracker&quot; module ' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../Utility Functions/Invoice_Tracker/Click_on_Invoice_Tracker_Module.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='assertExists' value='' type='web' desc='Validate invoices page' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='heading1(&quot;Invoices&quot;)' fallback='true' selected='true'/>
</dialect>
</step>
<step action='assertExists' value='' type='web' desc='Validate &quot;Go to last page&quot; button is visible ' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='svg(&quot;class==lucide lucide-arrow-right-to-line size-4 transition-transform duration-200&quot;)' fallback='true' selected='true'/>
   <accessor type='unknown' value='button(&quot;aria-disabled==false&quot;,above(span(&quot;Start Date&quot;)))' fallback='true' selected='false'/>
   <accessor type='unknown' value='submit(&quot;data-state==closed&quot;,above(span(&quot;Start Date&quot;)))' fallback='true' selected='false'/>
   <accessor type='unknown' value='svg(&quot;lucide lucide-arrow-right-from-line size-4&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='' type='web' desc='Click on &quot;Go to last page&quot; button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='svg(&quot;class==lucide lucide-arrow-right-to-line size-4 transition-transform duration-200&quot;)' fallback='true' selected='true'/>
   <accessor type='unknown' value='button(&quot;aria-disabled==false&quot;,above(span(&quot;Start Date&quot;)))' fallback='true' selected='false'/>
   <accessor type='unknown' value='submit(&quot;data-state==closed&quot;,above(span(&quot;Start Date&quot;)))' fallback='true' selected='false'/>
   <accessor type='unknown' value='svg(&quot;lucide lucide-arrow-right-from-line size-4&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../Utility Functions/Logout_Function.ds"' fallback='true' selected='true'/>
</dialect>
</step>
</testcase>