   <accessor type='XPath' value='byXPath(&quot;//section[@id=&apos;step1&apos;]/div/div/table/tbody/tr[5]/td[4]/label/span&quot;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/form/section/div/div/table/tbody/tr[5]/td[4]/label/span&apos;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[5]//td[4]//label//span[@class=&quot;label-text&quot;]&apos;)' fallback='true' selected='false'/>
