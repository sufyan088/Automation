</step>
<step action='assertTrue' value='isChecked(checkbox(&quot;de_exa_na_complaint4&quot;,_leftOf(cell(&quot;Watering/Discharge&quot;))))' type='web' desc='Watering/Discharge checkbox   should be checked NA' isThinkTime='false' isCommented='false' isMasked='false' sequence='0'>
  <dialect type='sahi'>
