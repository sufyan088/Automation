<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'To_Verify_That_The_User_Should_Be_Navigated_To_The_Pre_Screening_Page_When_Pre_Screening_Edit_Button_Is_Clicked_In_Participants_Page.ds' description= '' author= '' version= ''>
<dpl filename='{ds}/../../../../Resources/Digit_Eyes_JS_DPL.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='en_US'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='' type='web' desc='Login to Camp Server, Registration, Pre Screening, Pre Exam.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../Examination/To_Verify_That_Participant_Should_Be_Refered_To_Further_Examination_Screen_When_No_Button_Is_Clicked.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='Click on Participants.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='link(&quot;Participants&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='link(8, _in(div({&apos;id&apos;:&apos;navbars&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='link(&quot;nav-link[8]&quot;)' fallback='true' selected='false'/>
   <accessor type='AttrHref' value='link(&quot;patients.php&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;navbars&apos;]/ul/li[9]/a&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Participants&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/nav/div/div/ul/li[9]/a&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;a[href=&quot;patients.php&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='link(8, _in(div(&quot;navbars&quot;)))' fallback='true' selected='false'/>
   <accessor type='Text' value='link(&quot;Participants[1]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='' type='web' desc='Click on Participant name.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='cell($Participant_Name)' fallback='true' selected='true'/>
   <accessor type='unknown' value='cell()' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='Click on pre screening unlock button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Id' value='button(&quot;btnPreUnlock&quot;)' fallback='true' selected='true'/>
   <accessor type='AttrClass' value='button(&quot;btn btn-primary btn-sm[2]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathName' value='byXPath(&apos;//*[@name=&quot;btnPreUnlock&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrName' value='button(&quot;btnPreUnlock&quot;)' fallback='true' selected='false'/>
   <accessor type='Text' value='button(&quot;Unlock&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//button[@id=&apos;btnPreUnlock&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot; Unlock&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/div[4]/div[2]/button&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;btnPreUnlock&apos;)&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;container-fluid main-container mb-5 pt-0&quot;] &gt; div[class=&quot;col-md-12xxx contentxxx&quot;] &gt; div[class=&quot;row rowmb18 bg-prescreening py-1&quot;] &gt; div[class=&quot;col-3 text-end&quot;] &gt; button[class=&quot;btn btn-sm btn-primary&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#btnPreUnlock&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;button[name=&quot;btnPreUnlock&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathId' value='byXPath(&apos;//*[@id=&quot;btnPreUnlock&quot;]&apos;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='Click on stay here button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='button(&quot;Stay Here&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='button(0, _in(div({&apos;id&apos;:&apos;divDialog&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='button(&quot;btn btn-primary btn-sm[6]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;divDialog&apos;]/div/div/div/div[2]/div/button[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;btn btn-primary btn-sm&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot; Stay Here&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div[2]/div/div/div/div[2]/div/button&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;divDialog&apos;)/div[@class=&apos;modal-dialog modal-lg&apos;]/div[@class=&apos;modal-content&apos;]/div[@class=&apos;modal-body&apos;]/div[@class=&apos;row&apos;]/div[@class=&apos;col-sm-12 text-center&apos;]/button[@class=&apos;btn btn-primary btn-sm&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='button({&apos;onclick&apos;:&quot;location.href=&apos;patientview.php?p=QTEwMjA5LTIwMjQwNzAxLTAwMDI=&apos;&quot;})' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;modal-content&quot;] &gt; div[class=&quot;modal-body&quot;] &gt; div[class=&quot;row&quot;] &gt; div[class=&quot;col-sm-12 text-center&quot;] &gt; button[class=&quot;btn btn-primary btn-sm&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;.modal-content &gt; .modal-body &gt; .row &gt; .col-sm-12.text-center &gt; .btn.btn-primary.btn-sm&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='button(0, _in(div(&quot;divDialog&quot;)))' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='Click on Edit button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='button(&quot;Edit[1]&quot;)' fallback='true' selected='true'/>
   <accessor type='AttrName' value='button(&quot;btnEdit[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='AttrValue' value='button(&quot;Edit[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/div[4]/div[2]/button&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;/html[1]/body[1]/div[@class=&apos;container-fluid main-container mb-5 pt-0&apos;]/div[@class=&apos;col-md-12xxx contentxxx&apos;]/div[@class=&apos;row rowmb18 bg-prescreening py-1&apos;]/div[@class=&apos;col-3 text-end&apos;]/button[@id=&apos;btnEdit&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='button({&apos;onclick&apos;:&quot;location.href=&apos;prescreeningedit.php?p=QTEwMjA5LTIwMjQwNzAxLTAwMDI=&apos;&quot;})' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;container-fluid main-container mb-5 pt-0&quot;] &gt; div[class=&quot;col-md-12xxx contentxxx&quot;] &gt; div[class=&quot;row rowmb18 bg-prescreening py-1&quot;] &gt; div[class=&quot;col-3 text-end&quot;] &gt; button[class=&quot;btn btn-sm btn-primary&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='button(&quot;btn btn-primary btn-sm[2]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Pre Screening page is opened' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='bold(&quot;Pre-Screening&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&apos;//nav/div/a/b&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot; Pre-Screening&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/nav/div/a/b&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;/html[1]/body[1]/nav[@class=&apos;navbar navbar-expand-lg navbar-dark bg-prescreening&apos;]/div[@class=&apos;container-fluid&apos;]/a[@class=&apos;navbar-brand&apos;]/b[1]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>