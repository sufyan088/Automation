<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'To_Verify_That_Pre_Examination_UnLocked_Successfully_Pop_Up_Dialog_Should_Be_Displayed_When_Unlock_Button_Is_Clicked_In_Participants_Page.ds' description= '' author= 'appvance' version= ''>
<dpl filename='{ds}/../../../../Resources/Digit_Eyes_JS_DPL.csv' exectype='runstepbystep' errorhandling='' type='HashDPL' locale='en_US'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='' type='web' desc='Login to Camp Server, Registration, Pre Screening, Pre Exam.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../Examination/To_Verify_That_Participant_Should_Be_Refered_To_Further_Examination_Screen_When_No_Button_Is_Clicked.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='click' value='' type='web' desc='Click on Participants.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='link(&quot;Participants&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='link(8, _in(div({&apos;id&apos;:&apos;navbars&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='link(&quot;nav-link[8]&quot;)' fallback='true' selected='false'/>
   <accessor type='AttrHref' value='link(&quot;patients.php&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;navbars&apos;]/ul/li[9]/a&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Participants&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/nav/div/div/ul/li[9]/a&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;a[href=&quot;patients.php&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='link(8, _in(div(&quot;navbars&quot;)))' fallback='true' selected='false'/>
   <accessor type='Text' value='link(&quot;Participants[1]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='' type='web' desc='Click on Participant name.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='cell($Participant_Name)' fallback='true' selected='true'/>
   <accessor type='unknown' value='cell()' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='' type='web' desc='Click on Pre Exam Unlock button.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Id' value='button(&quot;btnPreExamUnlock&quot;)' fallback='true' selected='true'/>
   <accessor type='AttrClass' value='button(&quot;btn btn-primary btn-sm[3]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathName' value='byXPath(&apos;//*[@name=&quot;btnPreExamUnlock&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrName' value='button(&quot;btnPreExamUnlock&quot;)' fallback='true' selected='false'/>
   <accessor type='Text' value='button(&quot;Unlock[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//button[@id=&apos;btnPreExamUnlock&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/div[9]/div[2]/button&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;btnPreExamUnlock&apos;)&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;container-fluid main-container mb-5 pt-0&quot;] &gt; div[class=&quot;col-md-12xxx contentxxx&quot;] &gt; div[class=&quot;row rowmb18 bg-preexam py-1&quot;] &gt; div[class=&quot;col-3 text-end&quot;] &gt; button[class=&quot;btn btn-sm btn-primary&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#btnPreExamUnlock&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;button[name=&quot;btnPreExamUnlock&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathId' value='byXPath(&apos;//*[@id=&quot;btnPreExamUnlock&quot;]&apos;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='' type='web' desc='Verify that Unlocked Successfully popup displayed.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='bold(&quot;Unlocked Successfully&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='bold(0, _in(div({&apos;id&apos;:&apos;divDialog&apos;})))' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;divDialog&apos;]/div/div/div/div[1]/div/h4/b&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Unlocked Successfully&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div[2]/div/div/div/div/div/h4/b&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;divDialog&apos;)/div[@class=&apos;modal-dialog modal-lg&apos;]/div[@class=&apos;modal-content&apos;]/div[@class=&apos;modal-body&apos;]/div[@class=&apos;row&apos;]/div[@class=&apos;col-sm-12&apos;]/h4[1]/b[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='bold(0, _in(div(&quot;divDialog&quot;)))' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>