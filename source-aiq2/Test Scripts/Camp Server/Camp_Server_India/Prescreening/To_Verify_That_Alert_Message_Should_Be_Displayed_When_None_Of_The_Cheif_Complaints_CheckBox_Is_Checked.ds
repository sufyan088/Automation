<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'To_Verify_That_Alert_Message_Should_Be_Displayed_When_None_Of_The_Cheif_Complaints_CheckBox_Is_Checked.ds' description= '' author= '' version= ''>
<dpl filename='{ds}/../../../../Resources/Digit_Eyes_JS_DPL.csv' exectype='runstepbystep' errorhandling='' type='HashDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='$Camp_Cluster_URL' type='web' desc='Register participant script' isThinkTime='false' isCommented='false' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../Registration/To_Verify_That_Success_Pop_Dialog_Message_Should_Be_Displayed_When_Participants_Is_Successfully_Registered.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"{ds}/../../../../Utility Functions/Camp_Server/Login/UF_Navigate_To_Server_URL.ds"' fallback='true' selected='false'/>
   <accessor type='unknown' value='"{ds}/../../Camp_Server_Login/Login_To_The_Camp_Server.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='""' type='web' desc='Click on Prescreening button' isThinkTime='false' isCommented='false' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../Utility Functions/Camp_Server/Pre_Screening/UF_Click_On_Pre_Screening_Button.ds"' fallback='true' selected='true'/>
   <accessor type='Parent' value='link(3, _in(div({&apos;id&apos;:&apos;navbars&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='link(&quot;nav-link[3]&quot;)' fallback='true' selected='false'/>
   <accessor type='AttrHref' value='link(&quot;prescreening.php&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;navbars&apos;]/ul/li[4]/a&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Pre-Screening&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/nav/div/div/ul/li[4]/a&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;a[href=&quot;prescreening.php&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='link(3, _in(div(&quot;navbars&quot;)))' fallback='true' selected='false'/>
   <accessor type='Text' value='link(&quot;Pre-Screening&quot;)' fallback='true' selected='false'/>
   <accessor type='unknown' value='"REPOSITORY/VisionSpring/DigitEYES-VisionSpring/Utility Functions/Camp_Server/Pre_Screening/UF_Click_On_Pre_Screening_Button.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='' type='web' desc='Click on the participant' isThinkTime='false' isCommented='false' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='cell($Participant_Name)' fallback='true' selected='true'/>
   <accessor type='unknown' value='' fallback='false' selected='false'/>
   <accessor type='unknown' value='cell($)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='click on Next button' isThinkTime='false' isCommented='false' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='button(&quot;Next&quot;)' fallback='true' selected='true'/>
   <accessor type='AttrClass' value='button(&quot;btn btn-primary btn-sm&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathName' value='byXPath(&apos;//*[@name=&quot;btnNext&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Id' value='button(&quot;btnNext&quot;)' fallback='true' selected='false'/>
   <accessor type='AttrName' value='button(&quot;btnNext&quot;)' fallback='true' selected='false'/>
   <accessor type='AttrValue' value='button(&quot;Next&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//button[@id=&apos;btnNext&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;btn btn-sm btn-primary&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Next &quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/form/div[2]/div[2]/button[2]&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;btnNext&apos;)&quot;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='button({&apos;type&apos;:&apos;button&apos;})' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;row rowmb18&quot;] &gt; div[class=&quot;col-9 text-end&quot;] &gt; button[class=&quot;btn btn-sm btn-primary&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#btnNext&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;button[name=&quot;btnNext&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;button[value=&quot;Next&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathId' value='byXPath(&apos;//*[@id=&quot;btnNext&quot;]&apos;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='' type='web' desc='Verify the alert message text : Headache/Eye Strain cannot be left blank' isThinkTime='false' isCommented='false' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='div(&quot;Headache/Eye Strain cannot be left blank.&quot;)' fallback='true' selected='true'/>
</dialect>
</step>
</testcase>