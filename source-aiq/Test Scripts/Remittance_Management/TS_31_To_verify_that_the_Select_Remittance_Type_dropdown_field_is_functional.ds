<step action='click' value='""' type='web' desc='' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='span(&quot;Remittance method...&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//button[@id=&apos;:rmt:-form-item&apos;]/span&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;truncate&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Remittance method...&quot;]&apos;)' fallback='true' selected='false'/>
