   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;container-fluid&quot;] &gt; div[class=&quot;navbar-collapse collapse flex-grow-0&quot;] &gt; ul[class=&quot;navbar-nav me-auto mb-2 mb-sm-0x&quot;] &gt; li[class=&quot;nav-item&quot;] &gt; a[class=&quot;nav-link&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;a[href=&quot;home.php&quot;]&apos;)' fallback='true' selected='false'/>
</dialect>
</step>
