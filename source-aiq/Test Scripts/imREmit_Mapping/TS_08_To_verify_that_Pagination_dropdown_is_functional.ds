<step action='click' value='""' type='web' desc='Click on Select Configuration Type' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='button(&quot;Select Configuration Type...&quot;)' fallback='true' selected='true'/>
   <accessor type='XPathId' value='byXPath(&apos;//*[@id=&quot;:r3q6:-form-item&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='button(&quot;active:translate-y-px bg-root border border-input cursor-pointer disabled:cursor-not-allowed disabled:opacity-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-ring font-medium font-sans h-10 hover:bg-accent/70 hover:border-muted-foreground hover:text-accent-foreground inline-flex items-center justify-between px-4 py-2 ring-offset-background rounded-md text-accent-foreground text-sm transition-colors w-[260px]&quot;)' fallback='true' selected='false'/>
