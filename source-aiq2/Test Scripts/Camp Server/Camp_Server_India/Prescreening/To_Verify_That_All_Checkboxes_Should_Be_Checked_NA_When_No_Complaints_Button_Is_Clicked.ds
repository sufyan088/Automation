<step action='assertTrue' value='isChecked(checkbox(&quot;de_exa_na_complaint6&quot;,_leftOf(cell(&quot;Swelling&quot;))))' type='web' desc='Squint checkbox should be checked NA' isThinkTime='false' isCommented='false' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='AttrClass' value='span(&quot;label-text[14]&quot;)' fallback='true' selected='true'/>
