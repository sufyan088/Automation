   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div[3]/div/div[2]&apos;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='div({&apos;tabindex&apos;:&apos;0&apos;})' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='div(&quot;cursor-default data-[disabled]:cursor-not-allowed data-[disabled]:opacity-50 flex focus:bg-accent focus:text-accent-foreground hover:cursor-pointer items-center outline-none px-2 py-1.5 relative rounded-sm select-none text-sm transition-colors[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='Text' value='div(&quot;Desc&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
