<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'To_Verify_That_All_Checkboxes_Should_Be_Checked_NA_When_No_Complaints_Button_Is_Clicked.ds' description= '' author= '' version= ''>
<dpl filename='{ds}/../../../../Resources/Digit_Eyes_JS_DPL.csv' exectype='runstepbystep' errorhandling='' type='HashDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='$Camp_Cluster_URL' type='web' desc='Register participant script' isThinkTime='false' isCommented='false' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../Registration/To_Verify_That_Success_Pop_Dialog_Message_Should_Be_Displayed_When_Participants_Is_Successfully_Registered.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"{ds}/../../../../Utility Functions/Camp_Server/Login/UF_Navigate_To_Server_URL.ds"' fallback='true' selected='false'/>
   <accessor type='unknown' value='"{ds}/../../Camp_Server_Login/Login_To_The_Camp_Server.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='""' type='web' desc='click on dashboad button' isThinkTime='false' isCommented='false' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../Utility Functions/Camp_Server/Registration/UF_Click_On_Dashboard.ds"' fallback='true' selected='true'/>
   <accessor type='Parent' value='button(2, _in(div({&apos;id&apos;:&apos;divRegSuccess&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='button(&quot;btn btn-primary btn-sm mb-1[2]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;divRegSuccess&apos;]/div/div/div/div[2]/div/button[3]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot; Dashboard&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div[2]/div/div/div/div[2]/div/button[3]&apos;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='button({&apos;onclick&apos;:&quot;location.href=&apos;dashboard.php&apos;&quot;})' fallback='true' selected='false'/>
   <accessor type='Parent' value='button(2, _in(div(&quot;divRegSuccess&quot;)))' fallback='true' selected='false'/>
   <accessor type='Text' value='button(&quot;Dashboard&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='""' type='web' desc='Click on Prescreening button' isThinkTime='false' isCommented='false' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../Utility Functions/Camp_Server/Pre_Screening/UF_Click_On_Pre_Screening_Button.ds"' fallback='true' selected='true'/>
   <accessor type='Parent' value='link(3, _in(div({&apos;id&apos;:&apos;navbars&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='link(&quot;nav-link[3]&quot;)' fallback='true' selected='false'/>
   <accessor type='AttrHref' value='link(&quot;prescreening.php&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;navbars&apos;]/ul/li[4]/a&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Pre-Screening&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/nav/div/div/ul/li[4]/a&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;a[href=&quot;prescreening.php&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='link(3, _in(div(&quot;navbars&quot;)))' fallback='true' selected='false'/>
   <accessor type='Text' value='link(&quot;Pre-Screening&quot;)' fallback='true' selected='false'/>
   <accessor type='unknown' value='"REPOSITORY/VisionSpring/DigitEYES-VisionSpring/Utility Functions/Camp_Server/Pre_Screening/UF_Click_On_Pre_Screening_Button.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='' type='web' desc='click on participants' isThinkTime='false' isCommented='false' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='cell($Participant_Name)' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on NO complaint button' isThinkTime='false' isCommented='false' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../Utility Functions/Camp_Server/Pre_Screening/UF_Click_On_The_NO_Complaints_Button.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='assertTrue' value='isChecked(span(0, below(tableHeader(&quot;-NA-&quot;))))' type='web' desc='' isThinkTime='false' isCommented='true' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='isChecked(span(0, below(tableHeader(&quot;-NA-&quot;))))' fallback='true' selected='true'/>
   <accessor type='unknown' value='span(0, below(tableHeader(&quot;-NA-&quot;)))' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertTrue' value='isChecked(checkbox(&quot;de_exa_na_complaint1&quot;,_leftOf(cell(&quot;Headache/Eye Strain&quot;))))' type='web' desc='Verify Headache/Eye Strain should be checked NA' isThinkTime='false' isCommented='false' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='isChecked(span(&quot;label-text[2]&quot;))' fallback='true' selected='true'/>
   <accessor type='Parent' value='span(2, _in(section({&apos;id&apos;:&apos;step1&apos;})))' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//section[@id=&apos;step1&apos;]/div/div/table/tbody/tr[1]/td[4]/label/span&quot;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/form/section/div/div/table/tbody/tr/td[4]/label/span&apos;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[1]//td[4]//label//span[@class=&quot;label-text&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='span(2, _in(section(&quot;step1&quot;)))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='span(&quot;label-text[2]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertTrue' value='isChecked(checkbox(&quot;de_exa_na_complaint2&quot;,_leftOf(cell(&quot;Blurred Vision&quot;))))' type='web' desc='Blurred Vision checkbox should be checked NA' isThinkTime='false' isCommented='false' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='AttrClass' value='span(&quot;label-text[5]&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='span(5, _in(section({&apos;id&apos;:&apos;step1&apos;})))' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//section[@id=&apos;step1&apos;]/div/div/table/tbody/tr[2]/td[4]/label/span&quot;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/form/section/div/div/table/tbody/tr[2]/td[4]/label/span&apos;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[2]//td[4]//label//span[@class=&quot;label-text&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='span(5, _in(section(&quot;step1&quot;)))' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertTrue' value='isChecked(checkbox(&quot;de_exa_na_complaint3&quot;,_leftOf(cell(&quot;Pain/Redness&quot;))))' type='web' desc='Pain/Redness checkbox  should be checked NA' isThinkTime='false' isCommented='false' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='AttrClass' value='span(&quot;label-text[8]&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='span(8, _in(section({&apos;id&apos;:&apos;step1&apos;})))' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//section[@id=&apos;step1&apos;]/div/div/table/tbody/tr[3]/td[4]/label/span&quot;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/form/section/div/div/table/tbody/tr[3]/td[4]/label/span&apos;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[3]//td[4]//label//span[@class=&quot;label-text&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='span(8, _in(section(&quot;step1&quot;)))' fallback='true' selected='false'/>
