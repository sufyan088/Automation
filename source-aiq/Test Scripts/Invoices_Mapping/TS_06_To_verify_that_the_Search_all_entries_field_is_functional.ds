   <accessor type='Image' value='byImg(imgSection(readImg(&apos;{resources}/img-3138272.png&apos;),{x:0,y:0,w:1,h:1,cx:0.34,cy:0.40}))' coords='{x:0,y:0,w:1,h:1,cx:0.34,cy:0.40}' imgPath='img-3138272.png' fallback='true' selected='false'/>
</dialect>
