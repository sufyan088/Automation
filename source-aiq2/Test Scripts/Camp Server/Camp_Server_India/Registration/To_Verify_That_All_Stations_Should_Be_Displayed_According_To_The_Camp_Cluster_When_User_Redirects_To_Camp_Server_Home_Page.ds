<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'To_Verify_That_All_Stations_Should_Be_Displayed_According_To_The_Camp_Cluster_When_User_Redirects_To_Camp_Server_Home_Page.ds' description= '' author= '' version= ''>
<dpl filename='REPOSITORY/VisionSpring/DigitEYES-VisionSpring/Resources/Digit_Eyes_JS_DPL.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='' type='web' desc='' isThinkTime='false' isCommented='false' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../Camp_Server_Login/Login_To_The_Camp_Server.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='' isThinkTime='false' isCommented='false' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='link(&quot;Home&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='link(0, _in(div(&quot;navbars&quot;)))' fallback='true' selected='false'/>
   <accessor type='Parent' value='link(0, _in(div({&apos;id&apos;:&apos;navbars&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='link(&quot;nav-link&quot;)' fallback='true' selected='false'/>
   <accessor type='AttrHref' value='link(&quot;home.php&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;navbars&apos;]/ul/li[1]/a&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;nav-link&quot;]&apos;)' fallback='true' selected='false'/>
