   <accessor type='Text' value='paragraph(&quot;Supplier/[Sup]2534&quot;)' fallback='true' selected='false'/>
   <accessor type='unknown' value='paragraph($Multi_Character)' fallback='true' selected='false'/>
   <accessor type='unknown' value=' paragraph($Parent_Supplier) ' fallback='true' selected='false'/>
   <accessor type='unknown' value='paragraph($Parent_Supplier)' fallback='true' selected='false'/>
   <accessor type='unknown' value='paragraph(&quot;Qa Parent Customer&quot;)' fallback='true' selected='false'/>
