{
  "name": "vision-spring-playwright",
  "version": "1.0.0",
  "description": "Vision Spring Playwright Test Automation Framework",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "allure:clean-results": "node -e \"const fs=require('fs'); fs.rmSync('allure-results',{recursive:true,force:true}); fs.mkdirSync('allure-results',{recursive:true});\"",
    "framework:bundle": "node scripts/build-framework-bundle.js",
    "framework:bundle:zip": "powershell -NoProfile -Command \"$zip='framework-team-starter-kit.zip'; if (Test-Path $zip) { Remove-Item $zip -Force }; Compress-Archive -Path 'framework\\team-starter-kit\\*' -DestinationPath $zip -Force\"",
    "scaffold:source-aiq": "node scripts/bootstrap-aiq-structure.js",
    "scaffold:module": "node scripts/scaffold-module.js",
    "test:all": "playwright test tests/DigitEYESCamps_* tests/DigitEYESDataLoader_* tests/DigitEYESReporting_* tests/DigitEYESSettings_* --workers=3",
    "test:camps": "playwright test tests/DigitEYESCamps_* --workers=3",
    "test:dataloader": "playwright test tests/DigitEYESDataLoader_* --workers=3",
    "test:reporting": "playwright test tests/DigitEYESReporting_* --workers=3",
    "test:settings": "playwright test tests/DigitEYESSettings_* --workers=3",
    "test:manage-camps-cluster": "playwright test tests/DigitEYESCamps_ManageCampsCluster --workers=3",
    "test:camps-dataforsalesforce": "playwright test tests/DigitEYESCamps_DataForSalesforce --workers=3",
    "test:camps-participants": "playwright test tests/DigitEYESCamps_Participants --workers=3",
    "test:dataforsalesforce": "playwright test tests/DigitEYESDataLoader_DataForSalesForce --workers=3",
    "test:participant-consents": "playwright test tests/DigitEYESDataLoader_ParticipantConsents --workers=3",
    "test:change-log": "playwright test tests/DigitEYESDataLoader_SFDataLoaderChangeLog --workers=3",
    "test:errorcases": "playwright test tests/DigitEYESDataLoader_SFDataLoaderErrorCases --workers=3",
    "test:queue": "playwright test tests/DigitEYESDataLoader_SFDataLoaderQueue --workers=3",
    "test:camp-trends": "playwright test tests/DigitEYESReporting_CampTrends --workers=3",
    "test:internet-availability": "playwright test tests/DigitEYESReporting_InternetAvailability --workers=3",
    "test:popin-availability": "playwright test tests/DigitEYESReporting_PopinAvailability --workers=3",
    "test:summary-sheet": "playwright test tests/DigitEYESReporting_SummarySheetData --workers=3",
    "test:work-report-ip": "playwright test tests/DigitEYESReporting_WorkReportIPTeams --workers=3",
    "test:work-report-vs": "playwright test tests/DigitEYESReporting_WorkReportVSTeams --workers=3",
    "test:country-settings": "playwright test tests/DigitEYESSettings_CountrySettings --workers=3",
    "test:salesforce-mapping": "playwright test tests/DigitEYESSettings_DESalesforceFieldMapping --workers=3",
    "test:hospitals": "playwright test tests/DigitEYESSettings_Hospitals --workers=3",
    "test:implementation-partners": "playwright test tests/DigitEYESSettings_ImplementationPartners --workers=3",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --headed --debug",
    "report": "playwright show-report",
    "allure:brand": "node scripts/customize-allure-report.js",
    "allure:normalize": "node scripts/normalize-allure-suites.js",
    "report:combined:parallel": "npm run allure:clean-results && playwright test tests/DigitEYESCamps_* tests/DigitEYESDataLoader_* tests/DigitEYESReporting_* tests/DigitEYESSettings_* --workers=3 --reporter=allure-playwright && npx allure generate allure-results --clean -o Result/allure-report-combined && node scripts/customize-allure-report.js Result/allure-report-combined",
    "report:combined:parallel:portable": "npx allure generate allure-results --clean --single-file -o Result/allure-report-combined-single && node scripts/customize-allure-report.js Result/allure-report-combined-single",
    "report:combined:share": "npm run allure:clean-results && playwright test tests/DigitEYESCamps_* tests/DigitEYESDataLoader_* tests/DigitEYESReporting_* tests/DigitEYESSettings_* --workers=3 --reporter=allure-playwright && npx allure generate allure-results --clean --single-file -o Result/allure-report-combined-shareable && node scripts/customize-allure-report.js Result/allure-report-combined-shareable",
    "report:combined:share:zip": "powershell -NoProfile -Command \"$zip='Result\\allure-report-combined-shareable.zip'; if (Test-Path $zip) { Remove-Item $zip -Force }; Compress-Archive -Path 'Result\\allure-report-combined-shareable\\*' -DestinationPath $zip -Force\"",
    "report:combined:client": "node scripts/run-combined-client-report.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "allure-commandline": "^2.38.1",
    "allure-playwright": "^3.6.0"
  }
}
