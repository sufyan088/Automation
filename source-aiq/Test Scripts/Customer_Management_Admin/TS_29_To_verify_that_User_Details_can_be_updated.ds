<step action='click' value='""' type='web' desc='Click on &quot;Customer Management&quot;' isThinkTime='false' isCommented='false' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='link(&quot;Customer Management&quot;)' fallback='true' selected='true'/>
