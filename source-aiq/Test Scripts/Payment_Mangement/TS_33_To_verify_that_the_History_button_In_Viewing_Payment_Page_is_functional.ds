<step action='click' value='' type='web' desc='Click on &quot;Actions Icon&quot; button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='button([&quot;menu&quot;],below(paragraph(&quot;Actions&quot;)))' fallback='true' selected='true'/>
