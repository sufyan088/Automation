   <accessor type='AttrClass' value='span(&quot;truncate&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='' type='web' desc='Select Pay By Email from dropdown.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='div(&quot;Pay By Email&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='div(35, _in(div({&apos;id&apos;:&apos;root&apos;}))).xy(0.17, 0.30 )' fallback='true' selected='false'/>
   <accessor type='XPathId' value='byXPath(&apos;//*[@id=&quot;:r2fs:&quot;]&apos;).xy(0.17, 0.30 )' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='div(&quot;aria-selected:bg-accent aria-selected:text-accent-foreground cursor-pointer data-[disabled]:opacity-50 data-[disabled]:pointer-events-none flex items-center outline-none px-2 py-1.5 relative rounded-sm select-none text-sm&quot;).xy(0.17, 0.30 )' fallback='true' selected='false'/>
