   <accessor type='JQuery' value='byJQuery(&apos;#de_reg_village&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;input[name=&quot;de_reg_village&quot;]&apos;)' fallback='true' selected='false'/>
