<step action='click' value='""' type='web' desc='Check supplier checkbox.' isThinkTime='false' isCommented='false' isMasked='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='label(&quot;Supplier&quot;)' fallback='true' selected='true'/>
