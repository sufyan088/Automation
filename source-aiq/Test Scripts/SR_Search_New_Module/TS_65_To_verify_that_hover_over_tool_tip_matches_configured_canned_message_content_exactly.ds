<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TS_65_To_verify_that_hover_over_tool_tip_matches_configured_canned_message_content_exactly.ds' description= '' author= 'null' version= ''>
<dpl filename='REPOSITORY/IM_REPOSITO/Resources/IM_DPL1.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
