    "report:iteration-matrix:customer-management-admin-nm:last-failed:client": "node scripts/run-iteration-matrix-customer-management-admin-nm-last-failed-client-report.js",
    "report:iteration-matrix:customer-management-payment-method:last-failed:client": "node scripts/run-iteration-matrix-customer-management-payment-method-last-failed-client-report.js",
    "report:iteration-matrix:criteria-settings:client": "node scripts/run-iteration-matrix-criteria-settings-client-report.js",
    "report:iteration-matrix:criteria-settings:last-failed:client": "node scripts/run-iteration-matrix-criteria-settings-last-failed-client-report.js",
    "report:iteration-matrix:criteria-settings-two:client": "node scripts/run-iteration-matrix-criteria-settings-two-client-report.js",
    "report:iteration-matrix:criteria-settings-two:last-failed:client": "node scripts/run-iteration-matrix-criteria-settings-two-last-failed-client-report.js",
    "report:iteration-matrix:customer-management-admin-new:last-failed:client": "node scripts/run-iteration-matrix-customer-management-admin-new-last-failed-client-report.js",
    "report:iteration-matrix:last-failed:client": "node scripts/run-iteration-matrix-last-failed-client-report.js"
