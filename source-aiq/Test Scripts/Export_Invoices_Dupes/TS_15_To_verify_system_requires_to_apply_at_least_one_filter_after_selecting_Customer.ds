<step action='click' value='' type='web' desc='Click on the select customer dropdown field' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='div([&quot;Select customers (min 3 characters)&quot;]).xy(0.76, 0.36 )' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//main[@id=&apos;root&apos;]/article/main/article/div[2]/div[1]/form/div/div[1]/div[1]/button/div&quot;).xy(0.76, 0.36 )' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;flex min-w-0 max-w-full flex-1 flex-wrap gap-1 overflow-hidden&quot;]&apos;).xy(0.76, 0.36 )' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Select customers (min 3 characters)...&quot;]&apos;).xy(0.76, 0.36 )' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/main/article/main/article/div[2]/div/form/div/div/div/button/div&apos;).xy(0.76, 0.36 )' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;root&apos;)/article[@class=&apos;flex min-h-screen flex-col&apos;]/main[@class=&apos;break-word flex-1 overflow-auto bg-background px-6 py-4 md:ml-16&apos;]/article[1]/div[@class=&apos;space-y-2&apos;]/div[@class=&apos;flex flex-col gap-2&apos;]/form[1]/div[@class=&apos;flex flex-col gap-4 lg:flex-row lg:justify-between&apos;]/div[@class=&apos;flex flex-wrap items-end gap-2&apos;]/div[@class=&apos;space-y-2 flex flex-col&apos;]/button[@class=&apos;inline-flex items-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed ring-offset-background active:translate-y-px border border-input bg-root hover:bg-accent/70 hover:text-accent-foreground hover:border-accent-foreground h-10 py-2 px-4 cursor-pointer font-sans min-h-10 justify-between w-full min-w-64 max-w-96 overflow-hidden&apos;]/div[@class=&apos;flex min-w-0 max-w-full flex-1 flex-wrap gap-1 overflow-hidden&apos;]&quot;).xy(0.76, 0.36 )' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;flex flex-col gap-4 lg:flex-row lg:justify-between&quot;] &gt; div[class=&quot;flex flex-wrap items-end gap-2&quot;] &gt; div[class=&quot;space-y-2 flex flex-col&quot;] &gt; button[class=&quot;inline-flex items-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed ring-offset-background active:translate-y-px border border-input bg-root hover:bg-accent/70 hover:text-accent-foreground hover:border-accent-foreground h-10 py-2 px-4 cursor-pointer font-sans min-h-10 justify-between w-full min-w-64 max-w-96 overflow-hidden&quot;] &gt; div[class=&quot;flex min-w-0 max-w-full flex-1 flex-wrap gap-1 overflow-hidden&quot;]&apos;).xy(0.76, 0.36 )' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='div(&quot;flex flex-1 flex-wrap gap-1 max-w-full min-w-0 overflow-hidden&quot;).xy(0.76, 0.36 )' fallback='true' selected='false'/>
</dialect>
