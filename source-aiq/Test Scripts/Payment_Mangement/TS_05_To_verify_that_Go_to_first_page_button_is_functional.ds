<step action='click' value='' type='web' desc='Click on &quot;Go to next page&quot; button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='svg(&quot;class==lucide lucide-arrow-right-to-line size-4 transition-transform duration-200&quot;)' fallback='true' selected='true'/>
   <accessor type='unknown' value='button(&quot;aria-disabled==false&quot;,above(span(&quot;Start Date&quot;)))' fallback='true' selected='false'/>
   <accessor type='unknown' value='submit(&quot;data-state==closed&quot;,above(span(&quot;Start Date&quot;)))' fallback='true' selected='false'/>
   <accessor type='unknown' value='submit(&quot;data-state==closed&quot;,above(textbox([&quot;Enter account number...&quot;])))' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='' type='web' desc='Verify that &quot;Go to next page&quot; button is visible ' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='svg(&quot;class==lucide lucide-arrow-right-to-line size-4 transition-transform duration-200&quot;)' fallback='true' selected='true'/>
   <accessor type='unknown' value='button(&quot;aria-disabled==false&quot;,above(span(&quot;Start Date&quot;)))' fallback='true' selected='false'/>
   <accessor type='unknown' value='submit(&quot;data-state==closed&quot;,above(span(&quot;Start Date&quot;)))' fallback='true' selected='false'/>
   <accessor type='unknown' value='submit(&quot;data-state==closed&quot;,above(textbox([&quot;Enter account number...&quot;])))' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='' type='web' desc='Click on Go to first page button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value=' svg(&quot;class==lucide lucide-arrow-left-to-line size-4 transition-transform duration-200&quot;) ' fallback='true' selected='true'/>
   <accessor type='unknown' value='path([&quot;M3 12h14&quot;])' fallback='true' selected='false'/>
   <accessor type='unknown' value='submit(&quot;data-state==closed&quot;,above(span([&quot;pointer-events&quot;])))' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='' type='web' desc='Validate Go to first page button is visible' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value=' svg(&quot;class==lucide lucide-arrow-left-to-line size-4 transition-transform duration-200&quot;) ' fallback='true' selected='true'/>
   <accessor type='unknown' value='path([&quot;M3 12h14&quot;])' fallback='true' selected='false'/>
   <accessor type='unknown' value='submit(&quot;data-state==closed&quot;,above(span([&quot;pointer-events&quot;])))' fallback='true' selected='false'/>
</dialect>
